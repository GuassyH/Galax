#version 460 core

layout(local_size_x = 256) in;

struct Vertex {
    vec3 position;
    vec3 normal;
    vec2 texCoord;
    float pad[2]; // ensure std430 alignment
};

layout(std430, binding = 0) buffer Vertices {
    Vertex vertices[];
};

layout(std430, binding = 1) buffer Indices {
    uint indices[];
};

uniform int numVerts;
uniform int numTriangles;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= numVerts) return;

    vec3 sumNormal = vec3(0.0);

    // Loop over all triangles in the chunk
    for (uint t = 0u; t < uint(numTriangles); t++) {
        uint i0 = indices[t * 3 + 0];
        uint i1 = indices[t * 3 + 1];
        uint i2 = indices[t * 3 + 2];

        // If this vertex is part of the triangle, add its face normal
        if (i0 == idx || i1 == idx || i2 == idx) {
            vec3 p0 = vertices[i0].position;
            vec3 p1 = vertices[i1].position;
            vec3 p2 = vertices[i2].position;

            vec3 triNormal = cross(p1 - p0, p2 - p0);
            sumNormal += triNormal;
        }
    }

    vertices[idx].normal = normalize(sumNormal);
}